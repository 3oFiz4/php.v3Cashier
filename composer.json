{
    "name": "ramstore/php-v3cashier",
    "description": "Aplikasi Point of Sale (POS) Minimarket Ramstore berbasis CodeIgniter 4 MVC",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-zlib": "*",
        "codeigniter4/framework": "^4.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        }
    },
    "scripts": {
        "lint": "find app public -name '*.php' -exec php -l {} +",
        "backup": "php spark db:backup"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
